{
  "theme_light": {
    "accent": "#007BFF",
    "text": "#424242",
    "primary": "#FFFFFF",
    "secondary": "#F5F5F5",
    "secondarybutton": "#EEEEEE",
    "destructive": "#FF3B30",
    "success": "#34C759"
  },
  "theme_dark": {
    "accent": "#66B2FF",
    "text": "#FFFFFF",
    "primary": "#121212",
    "secondary": "#202020",
    "secondarybutton": "#333333",
    "destructive": "#FF453A",
    "success": "#30D158"
  },
  "start_flow": "flow://flows/survey1",
  "home": {
    "element": {
      "type": "list",
      "elements": [
        {
          "type": "alert",
          "title": "Test Protocol",
          "message": "Test protocol description. If downloaded via invitation, the following variables should be populated. Population: ${global:population}, Group: ${global:group}",
          "icon": "/assets/home_instructions.png"
        },
        {
          "type": "sessions",
          "left": {
            "text": "{0} Sessions Completed",
            "icon": {
              "url": "/assets/completed.png",
              "tint": false
            }
          },
          "right": {
            "text": "Launch Session",
            "icon": {
              "url": "/assets/unlocked.png",
              "tint": false
            },
            "action": "flow://flows/doses"
          }
        },
        {
          "type": "survey",
          "action": {
            "text": "Surveys",
            "action": "navmodal://Survey"
          }
        },
        {
          "type": "carousel",
          "title": "Carousel header",
          "actions": [
            {
              "text": "inputs!",
              "icon": "/assets/home_mindtrails.png",
              "action": "flow://flows/inputs",
              "backgroundcolor": "#1A206AFF",
              "markcompleted": true
            },
            {
              "text": "survey 1",
              "icon": "/assets/home_instructions.png",
              "action": "flow://flows/how%20was%20your%20day%3f",
              "backgroundcolor": "#1A00E05A",
              "markcompleted": true
            },
            {
              "text": "survey 2",
              "icon": "/assets/home_resources.png",
              "action": "flow://flows/survey2",
              "backgroundcolor": "#1A00C2FF",
              "markcompleted": true
            },
            {
              "text": "survey 3",
              "icon": "/assets/home_anxiety.png",
              "action": "flow://flows/survey3",
              "backgroundcolor": "#1A5C2FDA",
              "markcompleted": true
            }
          ]
        },
        {
          "type": "reports",
          "title": "Reports",
          "backgroundcolor": "#1A206AFF",
          "reports": [
            {
              "title": "survey 1, not a report",
              "action": "flow://flows/survey2"
            },
            {
              "title": "survey 2",
              "action": "flow://flows/survey2",
              "report": true
            },
            {
              "title": "survey 3",
              "action": "flow://flows/survey3",
              "report": true
            }
          ]
        },
        {
          "type": "tiles",
          "title": "Tiles header",
          "actions": [
            {
              "text": "Video Flow",
              "icon": "/assets/home_mindtrails.png",
              "action": "flow://flows/video",
              "backgroundcolor": "#1A206AFF",
              "markcompleted": false
            },
            {
              "text": "inputs!",
              "icon": "/assets/home_mindtrails.png",
              "action": "flow://flows/inputs",
              "backgroundcolor": "#1A206AFF",
              "markcompleted": true
            },
            {
              "text": "survey 1",
              "icon": "/assets/home_instructions.png",
              "action": "flow://flows/how%20was%20your%20day%3F",
              "backgroundcolor": "#1A00E05A",
              "markcompleted": true
            },
            {
              "text": "survey 2",
              "icon": "/assets/home_resources.png",
              "action": "flow://flows/survey2",
              "backgroundcolor": "#1A00C2FF",
              "markcompleted": true
            }
          ]
        }
      ]
    }
  },
  "menu": [
    {
      "text": "Home",
      "icon": "/assets/menu_home.png"
    },
	{
      "text": "Long",
      "icon": "/assets/menu_home.png",
	  "action": "flow://flows/long"
    }
  ],
  "settings": {
    "configs": "flow://flows/configs.json"
  },
  "surveys": {
    "survey_1": {
      "type": "frequency",
      "frequency": "00:05:00",
      "path": "flow://flows/survey1",
      "expiry": "00:02:00"
    },
    "survey_2": {
      "type": "frequency",
      "frequency": "14",
      "time": "20:00",
      "skip": 1,
      "path": "flow://flows/survey2"
    },
    "survey_3": {
      "type": "random",
      "period": "00:10:00",
      "choose": 3,
      "time": "${global:random_time,15:00}",
      "paths": [
        "flow://flows/random1",
        "flow://flows/random2",
        "flow://flows/random3"
      ]
    }
  },
  "reminders": {
    "reminder_1": {
      "type": "survey",
      "survey_id": "survey_1",
      "frequency": "00:01:00",
      "take": 2
    }
  }
}
